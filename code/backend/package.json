{
  "name": "globalinsight-backend",
  "version": "1.0.0",
  "description": "GlobalInsight 后端服务 — 商业与AI资讯聚合",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
