    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "fetch:static": "tsx scripts/fetch-static.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "bullmq": "^5.0.0",
    "cheerio": "^1.2.0",
